<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con ROL VISIBLE: NODO SENSOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleNodo"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NODO SENSOR"
                android:textColor="@color/color_on_primary_container"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/color_primary_container"
                app:chipCornerRadius="16dp"
                app:chipStrokeColor="@color/color_accent"
                app:chipStrokeWidth="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="🐟 Salmonitoreo"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeRole"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar Rol"
                android:textColor="@color/color_accent" />
        </LinearLayout>

        <!-- Tarjeta Estado de Conexión Bluetooth -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewBtStatusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/shape_status_dot"
                        android:backgroundTint="@color/color_warning" />

                    <TextView
                        android:id="@+id/tvBtServerStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Esperando estación..."
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleServer"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Detener servidor Bluetooth"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@color/color_surface_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestartServer"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="Reiniciar"
                        android:textColor="@color/color_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta Sliders de Sensores (Temperatura 0-40 °C, Turbidez 0-100 %) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎛️ Simulación de Sensores Físicos"
                    android:textColor="@color/color_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Slider Temperatura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Temperatura del Agua (0 - 40 °C)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTempValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21.0 °C"
                        android:textColor="@color/color_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.5"
                    android:value="21.0"
                    android:valueFrom="0.0"
                    android:valueTo="40.0"
                    app:thumbColor="@color/color_accent"
                    app:trackColorActive="@color/color_accent"
                    app:trackColorInactive="@color/color_surface_variant" />

                <!-- Slider Turbidez -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Turbidez del Agua (0 - 100 %)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTurbValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25.0 %"
                        android:textColor="@color/color_accent"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderTurb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:value="25.0"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    app:thumbColor="@color/color_accent"
                    app:trackColorActive="@color/color_accent"
                    app:trackColorInactive="@color/color_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Aireador (ACTIVADO en rojo / apagado en verde) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💨 Aireador de Oxígeno"
                        android:textColor="@color/color_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Badge ACTIVADO en rojo / apagado en verde -->
                    <TextView
                        android:id="@+id/tvAireadorStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_badge"
                        android:backgroundTint="@color/color_inactive"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="APAGADO"
                        android:textColor="@color/color_background"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAireadorRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Lógica: ON si Temp &lt; 18 o &gt; 26 °C, o Turbidez &gt; 60%"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />

                <!-- Selector de Modo de Aireador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAeratorAuto"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="AUTO"
                        android:textSize="12sp"
                        app:backgroundTint="@color/color_primary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAeratorOn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="ON"
                        android:textColor="@color/color_active"
                        android:textSize="12sp"
                        app:strokeColor="@color/color_active" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAeratorOff"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="OFF"
                        android:textColor="@color/color_inactive"
                        android:textSize="12sp"
                        app:strokeColor="@color/color_inactive" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Registro de Eventos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/color_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📋 Registro de Eventos"
                        android:textColor="@color/color_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLog"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Limpiar"
                        android:textColor="@color/color_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEventLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/color_background"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:minLines="4"
                    android:padding="10dp"
                    android:text="Iniciando registro de eventos..."
                    android:textColor="@color/color_text_secondary"
                    android:textSize="11sp" />

                <!-- Telemetría JSON (último envío) -->
                <TextView
                    android:id="@+id/tvJsonDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/color_surface_variant"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:text="Último JSON DATA: -"
                    android:textColor="@color/color_accent"
                    android:textSize="10sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
