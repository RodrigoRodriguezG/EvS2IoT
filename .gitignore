# Built application files
*.apk
*.aar
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log
*-debug.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Keystore files
*.jks
*.keystore
debug.keystore

# External native build folder
.externalNativeBuild
.cxx/

# OS specific files
.DS_Store
Thumbs.db

# Environment variables and local configs
.env

# Google Services configuration - CRITICAL: DO NOT IGNORE
!google-services.json
!app/google-services.json
